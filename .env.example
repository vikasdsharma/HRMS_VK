# Copy to  .env  (it is git-ignored) and fill in. Real environment variables / your cloud secret manager override this file.

# development | production   (production turns on secure cookies and HSTS - needs HTTPS)
HRMS_ENV=production

# --- Database -------------------------------------------------------------------------------
# Leave empty for local SQLite (hrms.db next to the code). For the cloud use PostgreSQL:
# HRMS_DATABASE_URL=postgresql+psycopg://hrms:CHANGE_ME@db:5432/hrms

# --- Secrets (generate once, store in a password manager / secret manager) --------------------
# Session signing key:   python -c "import secrets; print(secrets.token_hex(32))"
HRMS_SECRET_KEY=
# Encryption key for Aadhaar / PAN / bank numbers:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# LOSING THIS KEY = THE ENCRYPTED NUMBERS CANNOT BE RECOVERED. Keep a copy somewhere other than the database backups.
HRMS_FIELD_KEY=

# --- First start ----------------------------------------------------------------------------
# Password for the first platform admin ('admin'). If empty, a random one is printed once in the log.
# It must be changed at first login either way.
HRMS_INITIAL_ADMIN_PASSWORD=

# --- Network ----------------------------------------------------------------------------------
HRMS_HOST=127.0.0.1
HRMS_PORT=5000
# Set to 1 when the app sits behind nginx / Caddy / a cloud load balancer that sets X-Forwarded-* headers
HRMS_TRUST_PROXY=0
# Force the 'Secure' cookie flag (defaults to on in production). Needs HTTPS.
# HRMS_COOKIE_SECURE=1

# --- Behaviour ----------------------------------------------------------------------------------
# Where logs, backups and generated keys live (default ./data)
# HRMS_DATA_DIR=/data
HRMS_LOG_LEVEL=INFO
HRMS_SESSION_MINUTES=30
HRMS_LOGIN_MAX_FAILS=5
HRMS_LOGIN_LOCK_MINUTES=15
HRMS_BACKUP_KEEP=14
HRMS_UPLOAD_RETENTION_DAYS=180
HRMS_MAX_UPLOAD_MB=10
# 1 = apply database migrations at start-up (fine for one process). Containers run `manage.py migrate` instead.
HRMS_AUTO_MIGRATE=1

# --- docker-compose only --------------------------------------------------------------------------
POSTGRES_PASSWORD=
DOMAIN=hrms.example.com
